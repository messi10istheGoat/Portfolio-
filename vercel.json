{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 15
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
